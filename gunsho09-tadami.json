 "poems": [
  {
   "seq": "1",
   "text": "霞たつよしのゝ山を越くれはふもとそ春のとまり也ける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "やかすとも草はもえなん春日野をたゝ春の日に任せたらなむ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春くれはまつそうちみる石上めつらしけなき山田なれとも",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "たか爲そ民の年へてもる山は世をへて松の生そはる覽",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "みくまのゝ浦の濵ゆふたか舟の何かはいくへつみてかへらむ",
   "kana": "",
   "speaker": "南九",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "人しれす渡しそめけむ橋なれや思なからに絕にけるかな",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "吹風にまかする〓ともみをつくしまつと知てやさしてきつらん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あき風の關吹こゆるたひとにこゑうちそふるすまのうら浪",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "高砂の鹿なくあきのあらしにはかのこまたらに浪そ立ける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "さほ山のもみちの錦いくらともしらて霧たつ空そはるけき",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "こゆるぎの發はあきりにやつれつゝいかなる時になまめを愛",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "行くらすたひのやとりもむさしのゝ草結ふよはおもはしき哉",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "月わたる淺かの沼の水〓み夜は玉藻のなひくをそみる",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "おきつ浪よせはよせなん浮島にとしふる松をこゝなからみむ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "年ふれはこしのしらやま老にけりおほくの人の雪つもりつゝ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "若なとておほくの年をわかつめは君そ子日の松にゝるへき",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "戯の身にしあらねは稻荷山祈る日よりそさかはゆきける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "心にもいるひの弓はやまならぬ花のあたりにまとそことふる",
   "kana": "",
   "speaker": "忠見集",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "池近くうつりにけりな藤の花こゝのそこのといかておしまん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "深山いてゝ都へならは時鳥よひなきそへてことつてにせよ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "みな月のなこしはらふるかみの〓水水心心はなきやしぬらん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "浪の立水のあやをもけふみれは七夕のともおもほゆるかな",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "さやかにもみえすそ有けるあふ坂の駒よりみゆる望月のかけ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "萬代をわかゆるきくそをく露のまゆをひらくる時はきにけり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "色〓〓の木葉なかるゝ大ゐ川しもはかつらの紅葉とやみん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ひねむすにみれとも飽す木締つけて鴨の社におひやつかまし",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "年とにやらふなはして有つるを今年や終にゆきゝえぬへし",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "みよしのゝ山のわたるを分くれは春のわたりに成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "春日野の草はみとりに成にけり若なつまんと誰かしめけむ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "折てたにゆくへき物をよそにのみ見てやかたらむ山吹の花",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "よそにても井手の山吹みきといふを語らは外にちりも社すれ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "なにはかた行かふふねのつなて繩くる社みえね芦のまをなみ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "更科にやとりはとらしをは捨の山まててらせ秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "常陸なる筑波の山のもみち葉のなにあかすとか露のをくらん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "筑波山このもかのもの紅葉はは秋はくれともあかすそ有ける",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "ときせちはすまのせきにもかはらねは都に秋の風や吹らむ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "神のやとみつの社に祈すとけふより君と坂はゆかなむ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "水上のこゝらなかれて行水にいとゝなこしのかくらをそする",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "春かすみ立といふ日をむかへつゝ年のあるしとわれや成なん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "子日とも契らて君か野へくれは松にかゝりて世をやつくさむ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "人の身にきつゝはとまる春ゆへに惜こゝろのまとひける哉",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "年待に祭らんとてはきねばみむいたゝくかみのしらけゆく迄",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夜半にのみ鳴郭公おほつかなあやめとるへきけふはいつそも",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "ひこほしのかけを待夜はおほつかなほのかに照す月の入かた",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "みまほしと思ひし駒にひきむかへ君か車にあふさかのせき",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "花の香をけさはいかにそ君か爲まゆひろけたる菊の上の露",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "ゆふ暮になれは聞ゆるすゝむしを思ふはかりのたより成けり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "底深きしきつの淵にすますして網代によれるひをのみやみん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "諸共にくれとかひなき網代かなよそ白浪にひをしへぬれは",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "つみとかはめにしみえねはふる雪のきえぬ朝をみるはかりん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "うくひすの鳴ねをきけは山深みわれよりさきに春は來にけり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "水上のわたにかすみなたな引ははるのくれよりたきのしら糸",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "手もふれてことに出れとふちの花庭にうつれる浪そおりける",
   "kana": "",
   "speaker": "は",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "靑柳の糸をそよれる櫻花ほころひはてゝちらんよのため",
   "kana": "",
   "speaker": "ひ",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "いろ〓〓の紅葉のにしき霧立て殘れるはしはいく木とかみむ",
   "kana": "",
   "speaker": "つく",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "妻こふるしかなくときに成にけるわかひとりれを誰に聞せむ",
   "kana": "",
   "speaker": "忠見集",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "年〓とにかりつむいねはみえくれと老にけるみそ置ところなき",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "あら玉の春をもしらて故〓は立田の山のかすみをそみる",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "かせ寒みこほれる谷のみつしもそ春くる〓とをとくと待らん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "ふりはへて君が爲にと春の野につめるかたみの若菜なりけり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "春雨は降そめにしかうつたへに山をみとりになさんとやみし",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "わか宿の棺なたいみ朝ほらけ鳴うくひすの聲ほのかなり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "香をとめて人も見にこぬ梅花まちくらしつゝ獨をるかな",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "あをやきの糸はみたれて春ことに露のさまらぬをさや成覽",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "おしむへき庭のさくらほさかりにて心そ花にまつうつりぬる",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "山吹の花なき里の住ゐこそふりはへとをく出つとおもはめ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "をそく咲藤の花ゆへいつしかと我さへまつにかゝりぬるかな",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "かきりなきこひをのみして世中にあはぬためしを我や殘さん",
   "kana": "",
   "speaker": "忠見集",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "夢の〓となとかよるしも君をみむくるゝ待まも定なき世を",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あさみとり春をきぬとやみよしのゝ山の霞のおひそみゆ覽",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "春くれは若菜摘む野そ思ほゆるかたみにもらぬ人のなけれは",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "山河のなかれまさるは松かせや谷のこほりを吹てとくらん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "春雨そ山のみとりは染てけるいさ今よりはぬれ衣きむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "わかやとに梅の匂ひのみちぬれはおりてつめると人や思はむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "うくひすの初ねほのかにあし引の山へとひ出る聲聞ゆなり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "我やとのものともいはしさくら花折てくらふる人もあらなん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "靑柳のいとよりあふるほともなくとくしる物は月日なりけり",
   "kana": "",
   "speaker": "く",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "やまふきの花の汀に匂へはや澤に蛙のこゑ聞ゆらむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "わか宿の松にひさしき藤の花紫野にはさきやしぬらん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "くれことにおなし道にもまとふ哉我身のうちに戀はもえつゝ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "わかれてはくるゝもしらす戀しなは君やほとなき物と思はむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "折もあへす散ぬるむめの花によりよそなる人や我を恨みん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "我やとのやなきの色も春くれはみとりの糸に成にける哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "大空をてらす月をはおきなからかつらの影はくらくや有けん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "子日する野邊に小松のなかりせは千世の例に何をひかまし",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "梅花はる待わひて咲にけりいまは匂ひのそはる計そ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "まつはたゝ千とせ社つめひく人は幾その子日かそへわたらん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "行かへるほとさへとをき子日哉千世の松引かめのおの山",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "一もとをちとせはみてん松なれとあまたおほくも引てける哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "ひきてくる子日の松の千とせをは待みん君そひさしかるへき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "ひく松にちとせはくとも龜山に殘るよはひのおもほゆるかな",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "宮人の子日する野を九重に霞の立とよそにみるらん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "若菜摘野にはからきもなかりけりまつにしるへき君に任せて",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "春をあさみかたみの底にみたね共君か爲にとつめるわかなそ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "朝とにはきけむ物を櫻はなけふより後やちりなから見む",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "もろともにわれをしらねは櫻花誰かとも枝にしらすも有哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "このおれる櫻のえたの殘れるはあらき風をもあてしとや思",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "木なからそみるへかりけるさくら花折まにおほく散にける哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "櫻みるに有明の月に出たれは我より先に露そ置ける",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "ちる花をぬきもとめなん春くれはいとふりかくる靑柳の枝",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "井手にのみ有と聞えし山ふきの九重ちかく咲にけるかな",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "われを思ふ人そあるらし故〓にゐての山吹おりなからみつ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "山吹をおるとはなしに夕暮の蛙なくまて立る霞か",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "うくひすの鳴こゑ聞は深山出て我よりさきに春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "尋きて聞は有けり鴛のなくなる夏とおもひけるかな",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "春ゆかは花とゝもにしたひならんをくれは何の身にか成へき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "はかなくも花のちり〓〓まとふ哉行衞もしらぬ春にをくれて",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "大空と山路をたのむ春くれはたひゆく雲を霞とおもはん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "いつちとか夜はほたるの登るらん行衞もしらし草の枕に",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "吹かせに散ぬるならはきくの花雲井なりともあひはみてまし",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "あまたあらはそふへき物を神な月殘れる菊の限なりけり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "菊の花うつらぬえたのましれるをけふより後に霜はをかなん",
   "kana": "",
   "speaker": "忠見集",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "千とせふる霜のつるをはをきなから菊の花こそ久しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "またやあるとゝふ人あれや菊の花かきりなしとも惜るゝかな",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "住の江の松は老ぬと思ふらんかけにも浪のよりてみゆれは",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "水底のわくはかりにはくゝろらんよるひともなき瀧のしら糸",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "はつ雪にけさはおきても思かなさても有つ、2我身ふりめと",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "ぬさよりもなく〓〓我そたゝへまし涙をゝくる手向有やと",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "別路をいつかたへともしらぬ身は行人をこそとふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "ぬさよりも我やゆかましみちのおくの忍ふ計りのかたみ送に",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "遠けれは思はすとも忘れなんかたみをわけて送るまされり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "露にたにあてしと思ふ人しもそ時雨ふるころ旅に行けり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "をくれしといはぬ涙も手向にはとゝめかねつる物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "忘れすは人は越路と思へ共今はかへるの山をたのまん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "行道をうみちとのみはわひはてしかへるの山の松をたのみて",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "旅人の露はろふへきから衣またきも袖のぬれにけるかな",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "君か爲なてしもしるく此たひの手向の神と成そうれしき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "あし曳の山くるしくて下るともくたりて山はひとり越なん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "月影に道のあひたはあかくともこよひはともに出んとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "都出て難波のかたに行人は住よしと聞浦にとまるな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "たちまちの手向の神もしらすして袖に霧たつ旅のぬさ哉",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "白露のかるかやことにいさしらす草はも玉のくしけならまし",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "此山の道のかきりとおもへともかつまた道は遠き成へし",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "誰をかはこうの山邊のほとゝきす草の枕にたひ〓〓はなく",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "風おはぬ舟さか山はとし月もおなし所そとまり成ける",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "みねのうへに絕す雲のみ棚引は白くおちくる布引のたき",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "一たひもまたみぬ嶺にまとはぬは雨のあしこそ指南成けれ",
   "kana": "",
   "speaker": "下イ",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "菊ならぬ花にありせは散なまし植て霜にはをかせたれ共",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "わたれともぬるとはなしにわかみつる夢さき川を誰に語らん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "天津風ふけ井の浦にゐるたつのなとか雲ゐにかへらさるへき",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "やそうらのいたゝく雲の物なれは久しけれともまつは賴もし",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "たまさかにけふあひみれと鈴虫はむかしなからの聲そ聞ゆる",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "君か代に難波のうらは茂りあひぬあしかる事をせねは成へし",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "難波津のあなたの事は住よしの年ふる松そしらはァるらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "音にきゝめにはまたみぬ播磨なる響のなたと聞はまとか",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "年ふれは朽こそまされはし柱むかしなからの名にはかはらて",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "我宿はけふりと成て雲井なるいつこをさしてゆかむとすらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "住よしの岸ともいはてしら浪の猶打かけようらはなくとも",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "雲ゐよりくれはかなしき故〓をかりの道とそ思ふへらなる",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "みるめゆへ蜑にしたれと女郎花けふは我にそかつきなされる",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "空蟬はさもこそなかめ君ならてくるゝなつそと誰かつけまし",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "せみの聲くるゝなつそと思へとも秋も立やとなとかきさらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "おさなくて親となれたる雁のこをみやたてしても思ふへき哉",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "きえねはや時にあはせん春風にあたらてわひし谷の氷は",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "春とをくあれともゐての山ふきは心のゆけは折なからみつ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "浦に住鶴のあふきをわかかたの風かとのみもおもひけるかな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "なにそむる秋の扇の女郞花さきにけりともみゆる色かな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "いにしへのにきしはものか九重のきつゝかよふとおもふ心は",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "鳴とりのかよふ水たにあさきせに浮へる鴨はふたつつらねて",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "昨日まて恨みし風は大空のうき雲はらふつかひなりけり",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "白露に置きたるまゆみをし折ていかにつけとてみする成らん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "夢をこそねさめの程にかたりけめみたてまてにも聞えける哉",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "夏の日の暮かたに社あやしけれみのときもなくともみえねは",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "よそ人の馬にわか名は立はてぬこれにはつけむ物もなきかな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "ぬらさしとつゝみをれとも大空のかはきぬなれは露やをく覽",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "見しかとも誰とも志らす難波かた浪のよるみて歸りにしかは",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "住の江の松とほのかに聞しかはみちこし鹽やよるへかりけむ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "櫻花たかき梢のなひかすは歸りやしなんをりわひぬとて",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "折わひて歸らむものたたきかけの山のさくらは雲井成けり",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "いかてかはちらさてくへきふちの花風によりてそ浪も立らめ",
   "kana": "",
   "speaker": "曾禰好忠集",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "君か世にさかゆくへしと思ひせはさらまし物をたゝみねの道",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "浪高みよるへくもあらぬ舟なれや浦にもつけておき乍らみん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "すもりこも立にけるかとみるに社かひなき身さへ恨み有けれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "有へくは人につけつゝ今はなをたよりなきみと思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "人にます心つかひもある物をたよりなくてふ事をつくさん",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "いつこにか尋てあはむ身を分て君かゆるさぬ心つかひを",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "よそにしてわふる淚に我ならぬ人はふくれと思ひなす覽",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "いつかたに立よれとてい春霞おもはすにのみまつは知らむ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "誰ならん我名なからそ願るゝかくても終にあらしと思へは",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "はかなくてうきてみゆれと白雲の山にもかゝる心とをしれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "水くきの行てかへらす成ぬるをなにゝなかるゝ我身なる覽",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "傳にてもとひける物をはてもなくよりなき身とも思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "人を思ふ心のそこはいけなれやいひそむるより戀のつもれは",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "ほのか成聲はかりにやきり〓〓すねなくに秋の夜を明しつる",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "音にのみ聞てわたらぬあふ坂の關のふ水になかれぬるかな",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "そこにしてふかしといふは賴まれすあさくは影の絕せすも哉",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "月影に道のあたりはあかくともこよひばともに出んとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "一度もまたみぬ道のまとはぬは雨の下こそしるへ成けれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "をとに聞なるとのうらにかつくてふあまや侘しき君をみる哉",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "都にはありわひぬれは津の國の住よしといふかたへこそゆけ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "つの國のわか賴めりし住吉にたより浪こそまなく立けれ",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "言のはの中をなく〓〓もとむれはむかしの人にあひみつる哉",
   "kana": "",
   "speaker": "",
   "page": 517,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
